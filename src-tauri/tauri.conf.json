{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "酱菇婆专用视频压缩",
  "version": "0.1.0",
  "identifier": "com.framefold.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "酱菇婆专用视频压缩",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 650,
        "backgroundColor": "#ECEEF2",
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
